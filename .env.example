# Copy to .env and fill in, or set these through the web UI's Settings panel
# instead (it writes to a local gitignored file — see src/key_store.py).
# There is no offline mode: a configured provider + key is required for
# free-text/PDF ingestion and for every approval decision.

# xai | openai | anthropic
LLM_PROVIDER=xai

# Only the key matching LLM_PROVIDER is required.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_MODEL=grok-3
# LLM_BASE_URL=https://api.x.ai/v1
# INVENTORY_DB_PATH=inventory.db
# LOG_DIR=logs
# APPROVAL_SCRUTINY_THRESHOLD=10000
